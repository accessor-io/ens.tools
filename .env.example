# ENS Tools Environment Variables
# Copy this file to .env and fill in your values

# Fee Collection Contract Configuration
# Deploy FeeCollection.sol contract and set the deployed address here
VITE_FEE_COLLECTION_ADDRESS=0x0000000000000000000000000000000000000000

# Admin Address for Fee Collection
# Address that can withdraw fees from the FeeCollection contract
# Recommended: Use a multisig wallet (e.g., Gnosis Safe)
VITE_FEE_COLLECTION_ADMIN=0x0000000000000000000000000000000000000000

# ENS DAO Treasury Address
# Address where premium name sale proceeds go (minus marketplace fees)
# Default: 0xFe89cc7aBB2C4183683ab71653C4cdc9B02D44b7
# Verify this address is correct before production deployment
VITE_ENS_DAO_TREASURY=0xFe89cc7aBB2C4183683ab71653C4cdc9B02D44b7

# RPC URLs (Optional - for custom RPC endpoints)
# If not set, default public RPCs will be used
# VITE_RPC_MAINNET=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
# VITE_RPC_SEPOLIA=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
# VITE_RPC_OPTIMISM=https://opt-mainnet.g.alchemy.com/v2/YOUR_API_KEY
# VITE_RPC_ARBITRUM=https://arb-mainnet.g.alchemy.com/v2/YOUR_API_KEY
# VITE_RPC_BASE=https://base-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# API URL (Optional - for backend services)
# VITE_API_URL=http://localhost:3001/api
